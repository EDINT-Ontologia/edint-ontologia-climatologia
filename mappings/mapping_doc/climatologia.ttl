<phenomenon_instant_0> a rr:TriplesMap;

	rml:logicalSource [
		a rml:LogicalSource;
		rml:source "climatologia_normalizado.csv";
		rml:referenceFormulation ql:CSV

	];
	rr:subjectMap [
		a rr:SubjectMap;
		rr:template "https://example.org/recurso/eventoFenomeno/meteorologia/{_id}";
